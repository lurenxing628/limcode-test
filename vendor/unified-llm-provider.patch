+      encryptedContent: 'gAAAAB_SERVER_COMPACTION',
+      rawItem: COMPACTION,
+    },
+  };
+
+  function collectParts(chunks: any[]): any[] {
+    return chunks.flatMap(chunk => chunk.partsDelta ?? []).filter(part => 'providerContext' in part);
