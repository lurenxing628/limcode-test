{
  "contractKind": "client-feed",
  "contractRevision": "2026-07-31-r4",
  "status": "planned",
  "scope": "扩展宿主向网页视图提供有界读模型，不把前端同步再做成一套永久账本。",
  "persistence": {
    "clientChangeLog": false,
    "clientCommitTables": false,
    "sessionState": "memory-only",
    "rule": "事务提交后直接返回类型化变化；网页视图重载或发现缺口时重新读取有界快照。"
  },
  "crossHostSynchronization": {
    "detection": "sqlite-externalDataVersion",
    "notification": "local-onCommit-is-not-cross-host",
    "projection": "bounded-snapshot-required-on-external-change",
    "backgroundWake": "persistent-RuntimeDeliveryWake-owner-routed-level-scan",
    "daemonRequired": false
  },
  "session": {
    "fields": [
      "sessionId",
      "hostBootId",
      "nextMessageSeq",
      "inflightMessageSeq?",
      "lastAckedCommitSeq?",
      "snapshotRequired"
    ],
    "maxInflightDataMessages": 1,
    "rule": "每次网页视图连接创建新sessionId，关闭或重载后旧消息因sessionId不匹配被忽略。",
    "hostBootIdRule": "snapshot 与 changes 均携带 hostBootId；扩展宿主重启后 hostBootId 变化，客户端据此丢弃旧会话状态。",
    "unknownSessionRule": "出站请求收到 unknown-session 错误时，客户端整份重取快照，不逐条补拉或本地猜测合并。",
    "maxQueuedBatches": 8,
    "maxQueuedBytes": 4194304,
    "snapshotRequiredCoalesced": true,
    "queueOverflowRule": "先将共享当前ACK基线的未发送changes按(type,id)压缩为最新净变化；压缩后仍越过batch/bytes硬上限时，丢弃尚未发送的普通changes并合并为一个snapshot-required控制状态，等待当前inflight结束后读取新快照。"
  },
  "conversationViews": {
    "mainChat": "single-flight-open-and-focus-existing-per-host",
    "foreignOwner": "reject-only-the-occupied-conversation",
    "auxiliaryViews": "share-conversation-owner-with-independent-view-references",
    "hiddenView": "retain-ownership",
    "lastViewClosed": "release-only-after-runtime-work-and-command-pins-settle"
  },
  "snapshot": {
    "projections": [
      "navigation-summary",
      "active-conversation-window",
      "active-turn-summary",
      "active-tool-and-interaction-summary",
      "subagent-delivery-summary"
    ],
    "messageWindowLimit": 200,
    "activeRecordLimitPerType": 200,
    "maxBytes": 5242880,
    "maxBytesEnforcement": "hard-limit",
    "windowRecordSummaryMaxBytes": 2048,
    "windowRecordRule": "窗口记录只含摘要（单条不超过 windowRecordSummaryMaxBytes），正文一律经 details.onDemand 按需读取。",
    "includesFullContextHistory": false,
    "includesLargeToolContent": false,
    "fields": [
      "sessionId",
      "hostBootId",
      "snapshotCommitSeq",
      "projections"
    ],
    "snapshotCommitSeq": "快照读事务可见的最后 commitSeq；使用十进制整数字符串。"
  },
  "changes": {
    "source": "committed-transaction-result",
    "format": "typed-upsert-remove-batch",
    "oneBatchPerDatabaseCommit": false,
    "unsentCommitRangeCompaction": true,
    "durableReplayAcrossExtensionRestart": false,
    "applyOrder": "未发送commit range按首次出现的server-foreign-key-topological位置保持顺序，同一(type,id)采用最终写入；客户端原子应用最终净变化。",
    "applyAtomicity": "客户端原子应用整批：任一条目应用失败则整批作废并请求新快照。",
    "unknownTypeRule": "遇到未知 change type 时请求新快照，不做本地猜测合并。",
    "gapRule": "丢失、乱序、未知类型或应用失败时请求新快照",
    "fields": [
      "sessionId",
      "hostBootId",
      "commitSeq",
      "changes"
    ],
    "maxChangeBatchRecords": 500,
    "maxChangeBatchBytes": 1048576,
    "oneCommitOneAtomicBatch": true,
    "singleCommitOverflowRule": "不拆分事务形成半可见状态；不发送该普通批次，直接置 snapshot-required。",
    "queueOverflowRule": "不无限排队；先合并共享ACK基线的未发送commit range，同一(type,id)只保留最终净变化；合并后仍超限才丢弃未发送普通批次并进入单一snapshot-required。",
    "pendingSequenceRule": "未发送changes不分配messageSeq；只有真正进入inflight时才分配连续wire sequence，队列压缩不得制造messageSeq空洞。",
    "snapshotRequiredRule": "snapshot-required 本身只是一位控制状态，不形成队列；当前 inflight 完成后读取新有界快照。"
  },
  "pagination": {
    "mode": "keyset",
    "offsetAllowed": false,
    "frozenRowsAllowed": false,
    "requestFields": [
      "query",
      "sortId",
      "limit",
      "afterSortKey?",
      "afterId?"
    ],
    "responseFields": [
      "rows",
      "nextSortKey?",
      "nextId?",
      "hasMore"
    ],
    "stableOrder": "sortKey + id",
    "sortIdRegistry": {
      "message": "message_seq",
      "conversation": "created_at+id"
    },
    "sortKeyRule": "sortKey 一经发布不可变；禁止以 updated_at 类可变列注册 sortId。",
    "recencyReorderRule": "updated_at 类可变字段引起的重排由 changes upsert 在前端本地进行，不改变 keyset 排序键。",
    "maxPageRows": 200,
    "maxPageBytes": 524288,
    "rule": "使用上一页最后一行的稳定排序键继续查询；新插入的行不会让后续页重复或漏读已有行。"
  },
  "details": {
    "onDemand": [
      "message-content",
      "turn-intent-preview",
      "tool-arguments-content",
      "tool-result-content",
      "file-change-base-content",
      "file-change-content",
      "file-change-diff",
      "process-output",
      "context-projection-detail",
      "answer-content"
    ],
    "turnIntentPreview": {
      "version": 3,
      "kinds": [
        "guidance",
        "runtime_continuation"
      ],
      "runtimeContinuationRule": "运行时续跑预览必须经 RuntimeDeliveryIntentLink 解析到唯一 RuntimeDelivery，再按 RuntimeInboxItem.source_kind 投影后台进程或子 Agent 来源；禁止从 TurnIntent 文本猜测 delivery/source 身份。"
    },
    "maxResponseBytes": 2097152,
    "chunkedRead": {
      "when": "单条记录超过 maxResponseBytes",
      "requestFields": [
        "recordId",
        "offset",
        "maxBytes"
      ],
      "responseFields": [
        "chunk",
        "nextOffset?",
        "totalBytes",
        "hasMore"
      ],
      "rule": "按偏移分段读取直到 hasMore=false；每段响应仍受 maxResponseBytes 约束，客户端负责拼接。"
    }
  },
  "preview": {
    "messageType": "ephemeral-preview",
    "binding": "toolCallId",
    "persisted": false,
    "discardable": true,
    "resendOnReload": false,
    "rule": "工具预览为短暂消息：绑定 toolCallId，不入库、任一侧可丢弃，网页视图重载后不补发。"
  },
  "rendering": {
    "largeLists": "virtual-or-segmented",
    "messageHistory": "virtual-or-segmented",
    "customScrollbar": "AdvancedScrollbar",
    "customScrollbarPath": "webview/src/components/navigation/AdvancedScrollbar.vue",
    "virtualizedLists": [
      "message-timeline",
      "turn-history-list",
      "large-record-list"
    ],
    "acceptance": "千条消息时间线同时挂载的 Vue 组件数不超过 100。",
    "rule": "分页限制传输总量，虚拟滚动或分段渲染限制同时创建的Vue组件数量。"
  },
  "bridgePayload": {
    "structuredClonePlainDataOnly": true,
    "forbidden": [
      "Vue-or-Pinia-Proxy",
      "function",
      "DOM-event",
      "class-instance",
      "Map",
      "Set"
    ]
  },
  "secrets": {
    "allowed": [
      "dedicated-settings-read",
      "dedicated-settings-update"
    ],
    "forbidden": [
      "runtime-sqlite",
      "cas",
      "ordinary-client-state",
      "log",
      "error",
      "vsix"
    ]
  },
  "notes": [
    "r4: commitSeq 只在同一 hostBootId 内单调；snapshot 与 changes 通过原子 barrier 交接",
    "r5: 单 commit 批次和宿主内存队列均有 records/bytes 硬上限；共享ACK基线的未发送commit range先压缩净变化，仍超限才转单一snapshot-required；未发送批次不占用wire messageSeq",
    "r6: RuntimeDeliveryIntentLink 进入有界投影；turn-intent-preview v3 以 guidance/runtime_continuation 判别，并展示后台进程或子 Agent 的真实来源"
  ],
  "sequence": {
    "hostBootId": "每次 Extension Host 启动生成的新稳定随机 id",
    "commitSeq": "同一 hostBootId 内由数据库提交路径单调分配的十进制整数字符串",
    "persistenceAcrossHostRestart": false,
    "wireType": "decimal-integer-string",
    "rule": "hostBootId 变化或 commitSeq gap 时客户端丢弃本地增量状态并整份重取快照。"
  },
  "snapshotFeedHandoff": {
    "mode": "atomic-commit-seq-barrier",
    "registration": "snapshot read 与 changes feed 注册在 writer barrier 或等价原子机制下交接",
    "rule": "订阅不得遗漏 snapshotCommitSeq 之后的 commit；changes.commitSeq 必须严格连续，大于 snapshotCommitSeq。",
    "implementationFreedom": "合同不固定具体 mutex/worker 消息实现，但必须证明无 gap。",
    "persistentClientChangeLog": false
  },
  "collaborationProjection": {
    "scope": "selected-conversation-source-or-target-only",
    "snapshotSelection": "messages-sent-from-or-delivered-into-a-loaded-Turn-plus-incoming-pending-or-failed; each-incoming-card-loads-its-delivery; at-most-200-newest-by-message_seq",
    "liveWindow": "existing-per-type-bounds-and-atomic-snapshot-refresh",
    "messageBodiesInFeed": false,
    "messagePreview": "CollaborationMessage-envelope-carries-whitespace-normalized-text_preview-of-at-most-320-characters; full-body-only-through-explicit-read",
    "deliveryState": "sender-session-also-sees-the-RuntimeDelivery-of-its-loaded-outgoing-messages; newest-attempt-per-target-decides-waiting-failed-or-settled; failed-incoming-stays-visible-after-the-last-message-created-before-it-was-sent-or-before-the-first-message-when-older-than-every-message-and-nothing-earlier-exists-or-among-the-newest-3-pinned-below-every-message-when-newer-than-every-message-or-no-message-has-a-creation-time; a-failure-older-than-a-window-with-earlier-history-appears-once-that-history-loads; a-waiting-outgoing-message-or-result-reads-as-delivered-for-the-recipient-current-or-next-Turn",
    "boardBodiesInFeed": false,
    "relations": "independent-message-source-target-reply-and-request-links",
    "peerConversations": "snapshot-only-collaborationPeerConversations-for-peers-of-the-loaded-links-outside-navigation; sidebar-display_title; runtime-absent-peer-status-deleted; client-reads-only-observed-Conversation-remove-or-deleted-status-as-deleted-and-a-missing-peer-as-unknown",
    "runtimeContinuationPreview": "collaboration_message-source-kind-retains-sourceConversationId-mode-and-320-character-text-preview; never-user-authorization"
  }
}
